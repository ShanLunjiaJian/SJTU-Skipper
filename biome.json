{
  "files": {
    "includes": [
      "**/*.js",
      "**/*.jsx",
      "**/*.mjs",
      "**/*.cjs",
      "**/*.ts",
      "**/*.tsx",
      "**/*.mts",
      "**/*.cts",
      "**/*.css",
      "**/*.scss",
      "**/*.html",
      "**/*.htm",
      "**/*.json",
      "**/*.jsonc",
      "**/*.md",
      "**/*.yaml",
      "**/*.yml",
      "!!data",
      "!!node_modules",
      "!!src/ui/static/vendor",
      "!**/*.min.js",
      "!**/*.min.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "trailingNewline": true
  },
  "linter": {
    "enabled": true,
    "includes": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noRedundantUseStrict": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "includes": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
    "actions": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "quoteProperties": "asNeeded",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "operatorLinebreak": "after",
      "lineWidth": 100
    }
  },
  "css": {
    "formatter": {
      "quoteStyle": "double",
      "lineWidth": 100
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true
    }
  },
  "markdown": {
    "formatter": {
      "formatEmbeds": false
    }
  }
}
