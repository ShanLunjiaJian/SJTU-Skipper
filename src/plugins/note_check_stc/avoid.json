[
  {
    "avoid": "部分（表示数量时）",
    "type": "模糊量词",
    "why": "说不清是哪些、有多少",
    "use": "写出是哪些，或写出数量"
  },
  {
    "avoid": "相关",
    "type": "模糊量词",
    "why": "说不清具体指什么",
    "use": "写出具体的对象"
  },
  {
    "avoid": "优化 / 提升 / 改善（不带对象和数字时）",
    "type": "含糊动词",
    "why": "说不清改了什么、改了多少",
    "use": "写出改了什么，以及改动前后的数字"
  },
  {
    "avoid": "沉淀",
    "type": "行话",
    "why": "读者要先把行话翻译成具体动作才能理解",
    "use": "写具体动作：整理成文档、记录下来、做成模板"
  },
  {
    "avoid": "落地",
    "type": "行话",
    "why": "说不清到了哪一步：上线、执行还是交付",
    "use": "写具体状态：上线、开始执行、交付"
  },
  {
    "avoid": "链路",
    "type": "行话",
    "why": "说不清是哪些环节",
    "use": "写流程或具体的环节"
  },
  {
    "avoid": "对齐",
    "type": "行话",
    "why": "说不清是确认、统一还是商定",
    "use": "写具体动作：确认、统一、商定"
  },
  {
    "avoid": "进行 + 动作名词",
    "type": "虚动词",
    "why": "句子变长，动作藏进了名词",
    "use": "直接写动词"
  },
  {
    "avoid": "闭环",
    "type": "行话",
    "why": "说不清从哪一步到哪一步",
    "use": "写清流程的起点和终点"
  },
  {
    "avoid": "不是 X，而是 Y",
    "type": "口号句式",
    "why": "追求气势，没有说清实际是什么",
    "use": "直接写实际是什么；需要对比时拆成两句"
  },
  {
    "avoid": "一些",
    "type": "模糊量词",
    "why": "说不清有多少",
    "use": "写数量，或列出具体内容"
  },
  {
    "avoid": "非常 / 极其 / 十分",
    "type": "程度词",
    "why": "读者不知道程度到底有多高",
    "use": "删掉，或写数字"
  },
  {
    "avoid": "显著",
    "type": "程度词",
    "why": "说不清变化有多大",
    "use": "写变化前后的数字"
  },
  {
    "avoid": "大量",
    "type": "模糊量词",
    "why": "说不清有多少",
    "use": "写数量"
  },
  {
    "avoid": "对于……而言",
    "type": "翻译腔",
    "why": "外语长句直译留下的外壳，删掉后主语更清楚",
    "use": "删掉外壳，把对象写成主语"
  },
  {
    "avoid": "进一步",
    "type": "冗余",
    "why": "不说明下一步具体做什么",
    "use": "删掉，或写出具体做什么"
  },
  {
    "avoid": "颗粒度",
    "type": "行话",
    "why": "读者要先翻译才懂",
    "use": "写细到哪一级：按天、按条、按人"
  },
  {
    "avoid": "大幅",
    "type": "程度词",
    "why": "说不清幅度",
    "use": "写幅度"
  },
  {
    "avoid": "开展 + 名词",
    "type": "虚动词",
    "why": "句子变长，动作藏进了名词",
    "use": "直接写动词"
  },
  {
    "avoid": "做出 / 作出 + 名词",
    "type": "虚动词",
    "why": "句子变长，动作藏进了名词",
    "use": "直接写动词"
  },
  {
    "avoid": "底层逻辑",
    "type": "行话",
    "why": "说不清是原因、机制还是原则",
    "use": "写出具体的原因或机制"
  },
  {
    "avoid": "予以 / 加以 + 动作名词",
    "type": "虚动词",
    "why": "句子变长，读着像公文",
    "use": "直接写动词"
  },
  {
    "avoid": "打造",
    "type": "营销词",
    "why": "宣传用语，说不清具体做了什么",
    "use": "写具体动作：建、做、开发"
  },
  {
    "avoid": "实现 + 名词（实现增长、实现提升）",
    "type": "虚动词",
    "why": "说不清变化了多少",
    "use": "写出变化前后的数字"
  },
  {
    "avoid": "适当 / 必要时 / 视情况",
    "type": "模糊量词",
    "why": "读者不知道具体的标准或条件",
    "use": "写出具体的标准或触发条件"
  },
  {
    "avoid": "赋能",
    "type": "营销词",
    "why": "说不清具体做了什么",
    "use": "写出具体做了什么、让谁能做什么"
  },
  {
    "avoid": "随着……的发展",
    "type": "套话",
    "why": "开头铺垫，不增加信息",
    "use": "删掉，直接写事实"
  },
  {
    "avoid": "抓手",
    "type": "行话",
    "why": "说不清是手段、工具还是指标",
    "use": "写出具体的手段或工具"
  },
  {
    "avoid": "在……的背景下",
    "type": "套话",
    "why": "开头铺垫，不增加信息",
    "use": "删掉，或直接写原因"
  },
  {
    "avoid": "助力",
    "type": "营销词",
    "why": "说不清起了什么作用",
    "use": "写出具体效果"
  },
  {
    "avoid": "一站式",
    "type": "营销词",
    "why": "说不清包含哪些功能",
    "use": "列出包含的功能"
  },
  {
    "avoid": "极致",
    "type": "营销词",
    "why": "说不清达到了什么水平",
    "use": "删掉，或写指标"
  },
  {
    "avoid": "若干",
    "type": "模糊量词",
    "why": "说不清有多少",
    "use": "写数量"
  },
  {
    "avoid": "无缝",
    "type": "营销词",
    "why": "说不清怎么衔接",
    "use": "写清怎么衔接"
  },
  {
    "avoid": "值得注意的是 / 需要注意的是 / 需要指出的是",
    "type": "套话",
    "why": "删掉后意思不变",
    "use": "删掉无关开场，保留必要条件和例外"
  },
  {
    "avoid": "一定程度上",
    "type": "程度词",
    "why": "说不清程度",
    "use": "删掉，或写具体程度"
  },
  {
    "avoid": "起到……的作用",
    "type": "虚动词",
    "why": "句子变长，说不清具体作用",
    "use": "直接写具体作用"
  },
  {
    "avoid": "综上所述 / 总的来说",
    "type": "套话",
    "why": "删掉后意思不变",
    "use": "删掉，直接写结论；结论宜放在开头"
  },
  {
    "avoid": "众所周知",
    "type": "套话",
    "why": "不增加信息；读者未必知道",
    "use": "删掉，必要时给出处"
  },
  {
    "avoid": "全方位",
    "type": "营销词",
    "why": "说不清是哪些方面",
    "use": "列出具体方面"
  },
  {
    "avoid": "成功地 / 有效地",
    "type": "冗余",
    "why": "不增加信息",
    "use": "删掉"
  },
  {
    "avoid": "基于……的情况下",
    "type": "翻译腔",
    "why": "外语长句直译留下的结构",
    "use": "改成「如果……」或「在……时」"
  },
  {
    "avoid": "不仅是……更是 / 不只是……更是",
    "type": "口号句式",
    "why": "用递进句式追求气势，没有说清实际做了什么",
    "use": "直接写实际做了什么"
  }
]
